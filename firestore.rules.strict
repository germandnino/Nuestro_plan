rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function metaDoc(planId) {
      return get(/databases/$(database)/documents/meta/$(planId)).data;
    }
    function isOwner(planId) {
      return isSignedIn() && metaDoc(planId).ownerUid == request.auth.uid;
    }
    function isPartner(planId) {
      return isSignedIn() && metaDoc(planId).partnerUid == request.auth.uid;
    }
    function isMember(planId) {
      return isOwner(planId) || isPartner(planId);
    }
    function partnerCanWrite(planId) {
      let data = metaDoc(planId);
      return isPartner(planId) && (!('partnerRole' in data) || data.partnerRole != 'viewer');
    }

    // El Lector no escribe el documento compartido, con UNA excepción: sacar de ahí sus
    // propios datos privados al migrar al split de bolsillos. Sin esto, sus movimientos y
    // metas individuales se quedan en shared para siempre — él no puede escribir shared y
    // el Editor no puede moverlos, porque solo el dueño de un dato puede escribir su
    // bolsillo (ver syncLimpiarMisDatosDeShared en NP/app.js).
    //
    // La excepción es de una sola dirección: toca solo las cuatro listas y solo si
    // ENCOGEN. No puede agregar ni modificar, ni tocar config ni log.
    //
    // get(k, []) es deliberado: un plan viejo sin 'logros' rompería la comparación, y una
    // regla que falla al evaluarse deniega.
    //
    // Lo que esto NO impide: un Lector decidido podría vaciar las listas compartidas. Las
    // reglas no pueden inspeccionar de quién es cada elemento de una lista. El modelo de
    // amenaza aquí es "mi pareja usa la app normalmente", no un adversario.
    function soloQuitaLoSuyo() {
      return resource != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['metas', 'ingresos', 'gastos', 'logros', 'lastEditBy'])
        && request.resource.data.get('metas', []).size()    <= resource.data.get('metas', []).size()
        && request.resource.data.get('ingresos', []).size() <= resource.data.get('ingresos', []).size()
        && request.resource.data.get('gastos', []).size()   <= resource.data.get('gastos', []).size()
        && request.resource.data.get('logros', []).size()   <= resource.data.get('logros', []).size();
    }

    match /meta/{planId} {
      // Leer: miembros, o cualquier autenticado con el código de invitación
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.partnerUid == request.auth.uid
        || !('partnerUid' in resource.data)
        || resource.data.partnerUid == null
      );
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        // El owner administra todo
        resource.data.ownerUid == request.auth.uid
        // El invitado reclama el cupo vacío
        || (
          (!('partnerUid' in resource.data) || resource.data.partnerUid == null)
          && request.resource.data.partnerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['partnerUid', 'partnerEmail', 'partnerName'])
        )
        // El partner ya vinculado refresca sus propios datos
        || (
          resource.data.partnerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['partnerUid', 'partnerEmail', 'partnerName'])
          && request.resource.data.partnerUid == request.auth.uid
        )
      );
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /planes/{planId}/shared/{docId} {
      allow read: if isMember(planId);
      // Escribe el owner, o el partner cuyo rol no sea 'viewer'. El Lector solo puede
      // hacer la limpieza de su propia migración, y solo sobre shared/data.
      allow write: if isOwner(planId)
                      || partnerCanWrite(planId)
                      || (isPartner(planId) && docId == 'data' && soloQuitaLoSuyo());
    }

    match /planes/{planId}/bolsillos/{uid} {
      // Phase B: Estricto - Cada miembro solo puede leer/escribir su propio bolsillo
      allow read, write: if isMember(planId) && request.auth.uid == uid;
    }
  }
}
